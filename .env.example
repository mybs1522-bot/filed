# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Payment Gateway Configuration (Card-Only, zero country/address required)
# 1. Publishable Key (Client-side, starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# 2. Secret Key (Server-side, starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_...
